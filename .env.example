# ============================================================================
# LokLens Environment Configuration (.env)
# Copy this file to '.env' and update with your local MySQL credentials.
# NOTE: Never commit your real '.env' file with passwords to public Git!
# ============================================================================

# Flask Configuration
FLASK_ENV=development
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=loklens_db
